// 여백 커뮤니티 — Prisma 7 + libSQL(SQLite/Turso) 스키마
// 로컬: DATABASE_URL="file:./prisma/dev.db"
// 배포(Vercel): Turso libsql:// URL + TURSO_AUTH_TOKEN

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 익명 커뮤니티 글
model Post {
  id        String    @id @default(cuid())
  tag       String // 상속고민 | 마음위로 | 절차질문 | 일상공유
  title     String
  body      String
  comfort   Int       @default(0) // '위로' 공감 수
  reply     Int       @default(0) // 답변(댓글) 수. 댓글 작성 시 함께 증가
  reported  Int       @default(0) // 신고 누적 수. 일정 이상이면 운영 검토 대상
  createdAt DateTime  @default(now())
  comments  Comment[]

  @@index([createdAt])
  @@index([tag])
}

/// 글에 달린 익명 댓글
model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}
