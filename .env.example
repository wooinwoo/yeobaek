# ── 로컬 개발 ───────────────────────────────────────────────
# libSQL 파일 모드: 별도 계정/DB 없이 바로 동작합니다.
# (이 값만 .env에 두면 로컬 개발/테스트가 모두 동작합니다.)
DATABASE_URL="file:./prisma/dev.db"

# ── 프로덕션 (Vercel + Turso) ───────────────────────────────
# 아래 두 값은 로컬 .env에 넣지 말고 Vercel 프로젝트의
# Environment Variables(Production)에 등록하세요. (자세한 절차: DEPLOY.md)
# Turso(libSQL)는 서버리스 환경에서도 쓰기까지 영속됩니다.
#
#   1) turso db create yeobaek
#   2) turso db show yeobaek --url        → DATABASE_URL 값
#   3) turso db tokens create yeobaek     → TURSO_AUTH_TOKEN 값
#
# DATABASE_URL: libsql:// 로 시작하면 자동으로 원격(Turso) 모드로 연결됩니다.
# TURSO_AUTH_TOKEN: 위 토큰. file: 로컬 모드에서는 비워 두세요(불필요).
#
# DATABASE_URL="libsql://yeobaek-<org>.turso.io"
# TURSO_AUTH_TOKEN="eyJ...placeholder..."
