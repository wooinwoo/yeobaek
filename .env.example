# ── 로컬 개발 ───────────────────────────────────────────────
# libSQL 파일 모드: 별도 계정/DB 없이 바로 동작합니다.
DATABASE_URL="file:./prisma/dev.db"

# ── 프로덕션 (Vercel + Turso) ───────────────────────────────
# Turso(libSQL)는 서버리스에서 쓰기까지 영속됩니다.
#   1) turso db create yeobaek
#   2) turso db show yeobaek --url        → DATABASE_URL
#   3) turso db tokens create yeobaek     → TURSO_AUTH_TOKEN
# DATABASE_URL="libsql://yeobaek-<org>.turso.io"
# TURSO_AUTH_TOKEN="ey..."
